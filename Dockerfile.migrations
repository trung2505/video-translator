FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    alembic==1.12.1 \
    sqlalchemy==2.0.23 \
    psycopg2-binary==2.9.9 \
    pydantic==2.5.0 \
    pydantic-settings==2.1.0 \
    python-dotenv==1.0.0

COPY backend /app

ENTRYPOINT ["python", "-m", "alembic", "-c", "alembic.ini"]
CMD ["upgrade", "head"]
