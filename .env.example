# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_translator
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/video_translator

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=replace-me-with-secure-random
MEDIA_ROOT=/app/storage
PROCESSED_DIR=/app/storage/processed

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/video_translator
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=video_translator

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE=5000000000  # 5GB in bytes
UPLOAD_DIR=/app/uploads
PROCESSED_DIR=/app/processed

# Whisper
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_DEVICE=cuda  # cuda or cpu

# Translation
TRANSLATION_API=google  # google, azure, or custom
# Hugging Face cache (set to persistent path mounted into container)
HF_HOME=/cache/huggingface

# Translator model name (local m2m100)
TRANSLATOR_MODEL=facebook/m2m100_418M
TRANSLATOR_PROVIDER=local
# When true, allow API fallback (if configured) for untranslated segments
TRANSLATOR_API_FALLBACK=false
# Translator provider: local, api, or hybrid
TRANSLATOR_PROVIDER=local
# Allow API fallback when local fails (true/false)
TRANSLATOR_API_FALLBACK=false

# Email (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
